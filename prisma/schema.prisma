  jns_jab_id      String?              @db.Char(36)
  jenjang_jab_id  BigInt?              @db.UnsignedBigInt
  eselon_id       String?              @db.Char(36)
  bup             Int?                 @default(58)
  kelas_jabatan   Int?
  is_aktif        Int                  @default(1)
  is_deleted      Boolean              @default(false)
  created_at      DateTime?            @default(now()) @db.Timestamp(0)
  updated_at      DateTime?            @default(now()) @updatedAt @db.Timestamp(0)

  ref_eselon          ref_eselon?          @relation(fields: [eselon_id], references: [id])
  ref_jnsjab          ref_jnsjab?          @relation(fields: [jns_jab_id], references: [id])
  ref_jenjangjab      ref_jenjangjab?      @relation(fields: [jenjang_jab_id], references: [id])
  rwt_jabatan         rwt_jabatan[]
  ref_unitorganisasi  ref_unitorganisasi[]

  @@index([kategori], map: "idx_ref_jabatan_kategori")
  @@index([nama_jabatan], map: "idx_ref_jabatan_nama")
  @@index([eselon_id], map: "idx_ref_jabatan_eselon")
  @@index([jns_jab_id], map: "idx_ref_jabatan_jnsjab")
}

